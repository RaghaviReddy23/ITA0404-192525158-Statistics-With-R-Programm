# Factors of a number
n <- 20
cat("Factors of", n, "are:\n")
for(i in 1:n)
{
  if(n %% i == 0)
    print(i)
}

# Generate 10 random integers between -50 and 50
set.seed(123)
rand <- sample(-50:50, 10)
cat("Random Numbers:\n")
print(rand)

# FizzBuzz (1 to 100)
for(i in 1:100)
{
  if(i %% 15 == 0)
    print("FizzBuzz")
  else if(i %% 3 == 0)
    print("Fizz")
  else if(i %% 5 == 0)
    print("Buzz")
  else
    print(i)
}
