# 5x4 matrix by row
m1 <- matrix(1:20, nrow=5, ncol=4, byrow=TRUE)
rownames(m1) <- paste("R",1:5,sep="")
colnames(m1) <- paste("C",1:4,sep="")
print(m1)

# 3x3 matrix by column
m2 <- matrix(1:9, nrow=3, ncol=3, byrow=FALSE)
rownames(m2) <- c("A","B","C")
colnames(m2) <- c("X","Y","Z")
print(m2)

# 2x2 matrix
m3 <- matrix(c(10,20,30,40), nrow=2, byrow=TRUE)
rownames(m3) <- c("R1","R2")
colnames(m3) <- c("C1","C2")
print(m3)
