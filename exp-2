# 5x4 Matrix filled by row
mat1 <- matrix(1:20,
               nrow = 5,
               ncol = 4,
               byrow = TRUE,
               dimnames = list(
                 c("R1","R2","R3","R4","R5"),
                 c("C1","C2","C3","C4")
               ))

cat("5x4 Matrix (Filled by Row):\n")
print(mat1)

# 3x3 Matrix filled by column
mat2 <- matrix(1:9,
               nrow = 3,
               ncol = 3,
               byrow = FALSE,
               dimnames = list(
                 c("R1","R2","R3"),
                 c("C1","C2","C3")
               ))

cat("\n3x3 Matrix (Filled by Column):\n")
print(mat2)

# 2x2 Matrix filled by row
mat3 <- matrix(c(10,20,30,40),
               nrow = 2,
               ncol = 2,
               byrow = TRUE,
               dimnames = list(
                 c("R1","R2"),
                 c("C1","C2")
               ))

cat("\n2x2 Matrix (Filled by Row):\n")
print(mat3)
